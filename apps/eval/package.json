{
  "name": "@firma-kit/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Arnés de evaluación del verificador: matriz de confusión, latencias y puerta de calidad. No se publica.",
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --noEmit false",
    "eval": "pnpm build && node dist/run.js",
    "type-check": "tsc --noEmit",
    "gen:negatives": "node scripts/generate-synthetic-negatives.mjs"
  },
  "dependencies": {
    "@firma-kit/core": "workspace:*",
    "@firma-kit/verify": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80"
  }
}
