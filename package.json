{
  "name": "firma-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Módulo de firma reutilizable: dibujar, escribir, subir imagen o tomar foto, con limpieza de tinta y verificación visual on-device.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=11"
  },
