    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "turbo type-check",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
