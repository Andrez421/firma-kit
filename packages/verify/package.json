{
  "name": "@firma-kit/verify",
  "version": "0.0.0",
  "description": "Verificación visual on-device: ¿esto es una firma o la foto de otra cosa?",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@firma-kit/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "echo \"(pendiente: eslint)\" && exit 0"
  },
  "bin": {
    "firma-kit-verify": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
