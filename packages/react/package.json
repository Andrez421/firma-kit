{
  "name": "@firma-kit/react",
  "version": "0.0.0",
  "description": "Componentes React del módulo de firma: pestañas dibujar / escribir / subir / foto.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "firma-kit.css",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "dependencies": {
    "@firma-kit/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "echo \"(pendiente: eslint)\" && exit 0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.12",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./firma-kit.css": "./firma-kit.css",
    "./fonts.css": "./assets/fonts.css"
  }
}
